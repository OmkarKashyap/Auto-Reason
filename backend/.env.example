# Copy to backend/.env for local `uvicorn` runs (not used by docker-compose,
# which reads the repo-root .env instead).

ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auto_reason

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Alternative provider: set LLM_PROVIDER=groq to use Groq instead of Anthropic.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-value

# Optional: only needed for sign-in/persistent accounts. Anonymous graph
# creation works without this.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

RATE_LIMIT_PER_MINUTE=10
MAX_INPUT_CHARS=20000
