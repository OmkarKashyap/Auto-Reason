# Copy to .env and fill in real values. Never commit the real .env file.

# --- Backend ---
ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auto_reason
POSTGRES_PASSWORD=postgres

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Alternative provider: set LLM_PROVIDER=groq to use Groq instead of Anthropic.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-value

RATE_LIMIT_PER_MINUTE=10
MAX_INPUT_CHARS=20000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
